  "chartQueries": [
    {
      "chartUrl": "Kj21bi",
      "queryStr": [
        "select Date, sum(Spend) as Spend, sum(Click) as Click",
        "group by Date;",
        "",
        "select *, lag(Spend, 1, 0) as PreSpend, ",
        "  lag(Click, 1, 0) as PreClick;",
        "",
        "select *, Spend - PreSpend as DiffSpend,",
        "  Click - PreClick as DiffClick,",
        "  case ",
        "    when Click = 0 and PreClick = 0 then 'Zero'",
        "    when Click = 0 and PreClick != 0 then 'Stop'",
        "    when Click != 0 and PreClick = 0 then 'Start'",
        "    else NULL end as ClickType;",
        "",
        "select MAX(Spend, Click, Date) as 'Highest Spend to start seeing Click', ",
        "  MIN(Spend, Click, Date) as 'Lowest Spend to start seeing Click'",
        "where ClickType = \"Start\"",
        "",
        "APPEND",
        "",
        "select MAX(Spend, Click, Date) as 'Highest Spend to when stop seeing Click', ",
        "  MIN(Spend, Click, Date) as 'Lowest Spend to when stop seeing Click'",
        "where ClickType = \"Stop\"",
        "",
        "APPEND",
        "",
        "select MAX(Spend/Click as CPC, Spend, Click, Date) as 'Highest Spend per Click', ",
        "  MIN(Spend/Click as CPC, Spend, Click, Date) as 'Lowest Spend per Click'",
        "where ClickType is NULL",
        "",
        "APPEND (",
        "select *, ",
        "  DiffSpend * 100 / PreSpend as SpendPerc,",
        "  DiffClick * 100 / PreClick as ClickPerc,",
        "  DiffClick * 100 / PreClick - DiffSpend * 100 / PreSpend as DiffPerc ",
        "where ClickType is NULL;",
        "",
        "select MAX(DiffPerc, Spend, PreSpend, SpendPerc,",
        "    Click, PreClick, ClickPerc, Date) as 'Most gain on Click when increase Spend',",
        "  MIN(DiffPerc, Spend, PreSpend, SpendPerc, ",
        "    Click, PreClick, ClickPerc, Date) as 'Least gain on Click when increase Spend'",
        "where DiffSpend > 0",
        "",
        ")",
        "",
        "APPEND (",
        "select *, ",
        "  DiffSpend * 100 / PreSpend as SpendPerc,",
        "  DiffClick * 100 / PreClick as ClickPerc,",
        "  DiffClick * 100 / PreClick - DiffSpend * 100 / PreSpend as DiffPerc ",
        "where ClickType is NULL;",
        "",
        "select MIN(DiffPerc, Spend, PreSpend, SpendPerc,",
        "    Click, PreClick, ClickPerc, Date) as 'Most lost on Click when decrease Spend',",
        "  MIN(DiffPerc, Spend, PreSpend, SpendPerc, ",
        "    Click, PreClick, ClickPerc, Date) as 'Least lost on Click when decrease Spend'",
        "where DiffSpend < 0",
        ")",
        "",
        ";",
        "",
        "reverse_transpose(Name, Value, *);",
        "",
        "expand(value)"
      ]
    }
  ],
